# Copie para .env.producao e preencha. NUNCA versione o arquivo preenchido.
#
#   cp .env.producao.example .env.producao
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.producao up -d --build

# Dominio que ja aponta para este host (o TLS e emitido para ele).
DOMINIO=farol.seudominio.com.br
WEB_ORIGIN=https://farol.seudominio.com.br
HOSTS_CONFIAVEIS=farol.seudominio.com.br

# Banco. Gere: openssl rand -base64 24
POSTGRES_USER=farol
POSTGRES_PASSWORD=
POSTGRES_DB=farol

# Sem estes dois o servico se recusa a subir.
# Gere cada um: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FAROL_ADMIN_TOKEN=
FAROL_SAL_AUDITORIA=

# A chave do provedor. Fica so aqui, nunca no repositorio.
LLM_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai

# Tetos de uso. O teto diario e o que protege o credito da chave.
TETO_LLM_DIA=2000
LIMITE_LLM_MIN=12

MODO_ENSAIO=true
