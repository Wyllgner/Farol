# === Banco ===
DATABASE_URL=postgresql+psycopg://farol:farol@localhost:5434/farol

# === LLM ===
# openai | anthropic | fallback
# (fallback = classificacao deterministica por palavras-chave, sem API)
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Os dois papeis sao separados de proposito: classificar e barato, mas a
# geracao ancorada e onde o sistema nao pode inventar. Se a taxa de resposta
# sem fonte incomodar, suba so a geracao — sem tocar em codigo.
LLM_MODEL_CLASSIFICACAO=gpt-5-nano
LLM_MODEL_GERACAO=gpt-5-nano

# === Embeddings ===
# openai = mesma chave do LLM (1536 dimensoes)
# local  = sentence-transformers offline, sem custo por chamada (768 dimensoes)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_LOCAL=intfloat/multilingual-e5-base
# ATENCAO: mudar isto exige regerar a migration do chunk.
EMBEDDING_DIM=1536

# === Canal ===
# mirror = Espelho do WhatsApp (WebSocket local).
# Em producao: whatsapp_cloud_api, sem alterar o motor.
CHANNEL_ADAPTER=mirror

# === App ===
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
MODO_ENSAIO=true

# === Seguranca ===
# dev | producao
# Em producao o processo se recusa a subir com configuracao insegura,
# /docs deixa de existir e o token abaixo passa a ser obrigatorio.
AMBIENTE=dev

# Protege o Console de Demonstracao e a tela "Como o FAROL decide".
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio em dev = superficies abertas na maquina local.
FAROL_ADMIN_TOKEN=

# Entra no hash do IP na trilha de auditoria. Troque em producao: sem sal
# proprio, o hash e reversivel por forca bruta.
FAROL_SAL_AUDITORIA=farol-dev

# Hospedeiros aceitos no cabecalho Host, separados por virgula.
# Ex.: farol.exemplo.jus.br,www.farol.exemplo.jus.br
HOSTS_CONFIAVEIS=

# Tetos de uso. O de LLM protege o credito da chave: e a unica coisa que
# uma URL publica pode gastar de verdade.
LIMITE_REQ_MIN=120
LIMITE_LLM_MIN=12
# Chamadas ao provedor por dia. Estourou, o motor degrada para o fallback
# deterministico em vez de continuar gastando. 0 = sem teto.
TETO_LLM_DIA=2000

# Assinatura do webhook da Cloud API (X-Hub-Signature-256).
# Vazio = sem verificacao, aceitavel so enquanto o canal e o espelho local.
WHATSAPP_APP_SECRET=
